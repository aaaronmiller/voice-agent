#!/usr/bin/env bash
# Echo-Node setup wizard.
#
# Shim for tools/deploy_wizard.py — the interactive first-run configuration
# wizard referenced as ./wizard in the README. Run from the v2 directory:
#
#   cd v2 && ./wizard
#
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
else
  PY="python3"
fi

exec "$PY" "$ROOT/tools/deploy_wizard.py" "$@"
