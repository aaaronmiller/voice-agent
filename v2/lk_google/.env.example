# ── Echo-Node × Google Gemini Environment ────────────────────────
#
# Gemini Multimodal Live API — voice-in → voice-out.
# No separate STT/LLM/TTS needed. No LiveKit Cloud needed.
#
# 1. GOOGLE_API_KEY is already available in your shell environment
# 2. That's all you need for the voice pipeline!
# 3. Optional: LEMONSLICE_API_KEY for video avatar

# Google Gemini API key (already exported in ~/.bashrc or env)
# The agent reads GOOGLE_API_KEY from the environment automatically
# GOOGLE_API_KEY=AIzaSy...

# Gemini model to use
# Available: gemini-2.5-flash-native-audio-preview-12-2025 (default)
#            gemini-3.1-flash-live-preview (latest)
#            gemini-live-2.5-flash-native-audio (Vertex AI)
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck

# LiveKit — local dev server (self-hosted, no cloud needed)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=echo-node-google

# Optional: LemonSlice for video avatar
# Without this, the agent works in audio-only mode
# LEMONSLICE_API_KEY=

# Avatar appearance (public URL — only used if LemonSlice is configured)
# AVATAR_IMAGE_URL=https://...
