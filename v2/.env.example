# Echo-Node v2 environment variables
# Copy to .env and fill in your keys.
# Keys in .env override config.yaml values.

# OpenRouter API key (for fast/nemotron/gpt-audio agents)
OPENROUTER_API_KEY=

# OpenAI API key (for gpt-audio agents via OpenAI directly)
OPENAI_API_KEY=

# Hermes API key (for local Hermes agent at :8642)
HERMES_API_KEY=

# Odysseus API token
ODYSSEUS_API_TOKEN=

# Anthropic API key (future Claude route)
ANTHROPIC_API_KEY=

# Google Gemini API key (future Gemini route)
GOOGLE_API_KEY=
