# ── Echo-Node LemonSlice Environment ─────────────────────────────
#
# Two modes depending on whether you have LiveKit Cloud:
#
# MODE A: LiveKit Cloud (easiest — one key for all inference)
#   Sign up at livekit.io, get LIVEKIT_API_KEY + LIVEKIT_API_SECRET
#   Uses: agent_lemonslice.py (inference.* → LiveKit Cloud gateway)
#   The cloud handles STT/LLM/TTS — no per-provider keys needed
#   Set LIVEKIT_URL to your cloud project's WebRTC endpoint
#
# MODE B: Local lk-server + individual API keys
#   Uses: agent_lemonslice_local.py (direct plugins)
#   Runs lk-server --dev locally for WebRTC
#   Needs separate keys for each provider (Deepgram, OpenAI, etc.)
#   Set LIVEKIT_URL=ws://127.0.0.1:7880

# ═════════════════════════════════════════════════════════════════
# REQUIRED (both modes)
# ═════════════════════════════════════════════════════════════════

# LemonSlice avatar API (sign up at https://lemonslice.com)
LEMONSLICE_API_KEY=

# ═════════════════════════════════════════════════════════════════
# MODE A: LiveKit Cloud inference
# ═════════════════════════════════════════════════════════════════
# With these, agent_lemonslice.py handles all STT/LLM/TTS via LiveKit.
# No separate API keys needed for OpenAI, Deepgram, etc.
#
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# LIVEKIT_URL=wss://your-project.livekit.cloud
# AGENT_NAME=lemonslice-echo-node

# ═════════════════════════════════════════════════════════════════
# MODE B: Local server + individual API keys
# ═════════════════════════════════════════════════════════════════
# With these, agent_lemonslice_local.py calls providers directly.
# Each needs its own API key.
#
# WebRTC endpoint (local lk-server)
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
#
# Deepgram (STT) — available from env
# DEEPGRAM_API_KEY=...
#
# LLM — pick one:
#   OpenAI:   OPENAI_API_KEY=sk-...
#   OpenRouter: OPENAI_API_KEY=sk-or-...   LLM_BASE_URL=https://openrouter.ai/api/v1
#   Groq:     OPENAI_API_KEY=gsk_...       LLM_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
#
# TTS — needs a real OpenAI key or separate TTS_API_KEY
# TTS_API_KEY=

# ═════════════════════════════════════════════════════════════════
# Appearance (same for both modes)
# ═════════════════════════════════════════════════════════════════
# Must be a publicly reachable HTTP(S) URL (LemonSlice servers fetch this)
AVATAR_IMAGE_URL=https://6ammc3n5zzf5ljnz.public.blob.vercel-storage.com/inf2-uploads/image_9d0f6-WhaKqLKTzfVHlfe5jXzHE8Rpi9peF4.jpg
