# Voice Agent — Runtime API Keys
# Copy this file to .env and fill in your keys.
# .env is already gitignored — your secrets stay local.
#
# If a key is not in .env, the script falls back to the matching
# global environment variable (OPENROUTER_API_KEY, OPENAI_API_KEY, etc.).

# OpenRouter API key — used for model routing
# OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI API key — used for Odyssey / OpenAI models
# OPENAI_API_KEY=sk-...
