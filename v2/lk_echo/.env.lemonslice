# ── Echo-Node LemonSlice Environment ─────────────────────────────
#
# 1. Copy:   cp .env.lemonslice .env
# 2. Edit:   fill in the keys marked (required)
# 3. Run:    ./lk_echo/run_lemonslice.sh

# ── LemonSlice avatar API ───────────────────────────────────────
# Required! Sign up at https://lemonslice.com to get your API key
LEMONSLICE_API_KEY=

# ── Deepgram STT ─────────────────────────────────────────────────
# Already in your environment — but set here for the agent to pick up
DEEPGRAM_API_KEY=

# ── LLM ──────────────────────────────────────────────────────────
# Pick one option and uncomment it:
#
# Option A: OpenAI
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Option B: OpenRouter (uses your key from env)
#   OPENAI_API_KEY=sk-or-v1-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-4o-mini
#
# Option C: Groq (fast, free tier)
#   OPENAI_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ── TTS ──────────────────────────────────────────────────────────
# REQUIRED for voice. Uses OPENAI_API_KEY by default.
# Set a separate key here if your LLM key doesn't work for TTS.
TTS_API_KEY=

# ── LiveKit (local dev server) ───────────────────────────────────
# These are the lk-server --dev defaults
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=lemonslice-echo-node

# ── Avatar appearance ────────────────────────────────────────────
# Must be a publicly reachable HTTP(S) URL (LemonSlice servers fetch this)
# This is the "Jess" reference image — a young woman with black hair
AVATAR_IMAGE_URL=https://6ammc3n5zzf5ljnz.public.blob.vercel-storage.com/inf2-uploads/image_9d0f6-WhaKqLKTzfVHlfe5jXzHE8Rpi9peF4.jpg
