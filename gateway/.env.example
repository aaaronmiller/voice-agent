# Echo-Node Gateway Configuration
# Copy to .env and fill in your values

# Server
GATEWAY_PORT=3000
GATEWAY_HOST=127.0.0.1

# Google Gemini Live API
GEMINI_API_KEY=

# OpenAI Realtime API
OPENAI_API_KEY=

# Hermes Agent (for legacy provider fallback)
HERMES_API_KEY=
HERMES_URL=http://127.0.0.1:8642/v1

# Default provider
ECHO_DEFAULT_PROVIDER=gemini-live
